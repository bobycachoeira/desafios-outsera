{
  "name": "desafio-1-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Testes automatizados de API (Jest + Supertest) — Desafio Outsera.",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:positive": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/positive",
    "test:negative": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/negative",
    "test:report": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --reporters=default --reporters=jest-html-reporters"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "dotenv": "^16.4.0",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
